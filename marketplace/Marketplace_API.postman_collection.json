{
  "info": {
    "name": "Mini Marketplace REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/marketplace/api"
    }
  ],
  "item": [
    {
      "name": "1. GET semua produk",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response JSON\", function () { pm.response.to.be.json; });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/produk.php",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "produk.php"
          ]
        }
      }
    },
    {
      "name": "2. GET detail produk (id=1)",
      "event": [
        {
          "listen": "test",
